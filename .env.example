# Browser client (Vite exposes only VITE_-prefixed vars to the client bundle)
VITE_SUPABASE_URL=https://ovzrhtwccbjkquqifhgc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel serverless functions in /api) — never expose these to the client
SUPABASE_URL=https://ovzrhtwccbjkquqifhgc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# Where staff get notified of new /contact form submissions (defaults to info@jumpstartsportspgh.com)
SUPPORT_NOTIFY_EMAIL=

# Shared secret the Cloudflare Email Worker (cloudflare/support-email-worker) presents as a
# Bearer token when it POSTs to /api/inbound/email. Must match the worker's own env var.
SUPPORT_INBOUND_SECRET=
